# Copy to .env and fill in the real values.
HOST=127.0.0.1
PORT=3010

# Required for a public deployment. Share this with your partner.
ACCESS_CODE=

# Required: a long random string, e.g. `openssl rand -hex 32`.
SECRET=

# Runtime data (cache, uploads, live-source lists). Keep out of git.
DATA_DIR=./data
YTDLP=yt-dlp
FFMPEG=ffmpeg

# Keep low on a 1 GB server.
RESOLVE_CONCURRENCY=1
RESOLVE_TIMEOUT_MS=70000

# Playback/session and sleeping-room retention.
SESSION_TTL_MS=21600000
SLEEPING_ROOM_TTL_MS=604800000

# Shared HLS segment cache.
SEGMENT_CACHE_MAX_BYTES=1073741824
SEGMENT_CACHE_TTL_MS=21600000

# Chat image uploads.
MAX_UPLOAD_BYTES=6291456
UPLOAD_TTL_MS=604800000

# Optional WebRTC ICE servers for voice chat. JSON array; STUN works for most
# home networks, add a TURN server for strict NAT / mobile networks.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]

# Optional external browser sniffer (hipy-sniffer, GPL-3.0, separate process).
# SNIFFER_URL=http://127.0.0.1:5708
# SNIFFER_AUTH=
# SNIFFER_TIMEOUT_MS=30000
# SNIFFER_EXCLUDE=obj/tos|loadjs|byteimg
# BROWSER_SNIFFER_HOSTS=

# Built-in live TV. Empty BUILTIN_LIVE_LIST uses the curated direct-play
# channels; set it to import a full external m3u list instead.
# BUILTIN_LIVE_NAME=内置 · 精选直连
# BUILTIN_LIVE_LIST=

# Reserved; leave off.
MERGE_ENABLED=0

# Never enable in production. Only for local/lab testing against private URLs.
ALLOW_PRIVATE_URLS=0
